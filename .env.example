# Upstox developer app credentials (create one at https://account.upstox.com/developer/apps)
UPSTOX_API_KEY=your_api_key
UPSTOX_API_SECRET=your_api_secret
# Must exactly match the redirect URI registered on the Upstox app
UPSTOX_REDIRECT_URI=http://localhost:8123/callback

# Optional: paste an access token directly instead of running `python -m onlyichu login`
# UPSTOX_ACCESS_TOKEN=
