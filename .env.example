# Upstox developer app credentials (create one at https://account.upstox.com/developer/apps)
# These are OPTIONAL here — you can also enter them on the dashboard's "Connect Upstox"
# screen, which saves them for you. If set here they take priority.
UPSTOX_API_KEY=your_api_key
UPSTOX_API_SECRET=your_api_secret
# Must exactly match the redirect URI registered on the Upstox app. To let the web
# dashboard capture the login automatically, register the dashboard's callback:
UPSTOX_REDIRECT_URI=http://127.0.0.1:8080/callback

# Optional: paste an access token directly instead of logging in
# UPSTOX_ACCESS_TOKEN=
